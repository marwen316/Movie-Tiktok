{
  "name": "Movie-Tiktok - Publication privee programmee",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "tick",
      "name": "Chaque minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/api/tiktok/schedule/run-due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        }
      },
      "id": "send",
      "name": "Publier les videos dues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8080/api/tiktok/schedule/check-status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "check",
      "name": "Verifier les publications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Chaque minute": {
      "main": [
        [
          {
            "node": "Publier les videos dues",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publier les videos dues": {
      "main": [
        [
          {
            "node": "Verifier les publications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Europe/Paris",
    "executionOrder": "v1"
  },
  "active": false
}
